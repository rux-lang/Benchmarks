// Baseline: runs every module once and prints an FNV-1a hash of their results.
// Generated by `dotnet run --project Runner -c Release -- generate`; change the generator, not this file.
import Io::PrintLine;

func Main() -> int {
    var hash: uint64 = 0xCBF29CE484222325u64;
    hash = Group0::RunAll(hash);
    PrintLine("{:016x}", hash);
    return 0;
}
