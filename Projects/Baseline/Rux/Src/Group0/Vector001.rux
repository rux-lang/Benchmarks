// Vector001: fixed-point 3D vector arithmetic: sums, cross products and dot products of random vectors.
// Generated by `dotnet run --project Runner -c Release -- generate`; change the generator, not this file.
pub module Group0::Vector001 {
    struct Vector001Vec3 {
        x: uint64;
        y: uint64;
        z: uint64;
    }

    extend Vector001Vec3 {
        func Add(self: &Vector001Vec3, other: &Vector001Vec3) -> Vector001Vec3 {
            return Vector001Vec3 { x: self.x + other.x, y: self.y + other.y, z: self.z + other.z };
        }

        func Scale(self: &Vector001Vec3, factor: uint64) -> Vector001Vec3 {
            return Vector001Vec3 { x: self.x * factor, y: self.y * factor, z: self.z * factor };
        }

        func Dot(self: &Vector001Vec3, other: &Vector001Vec3) -> uint64 {
            return self.x * other.x + self.y * other.y + self.z * other.z;
        }

        func Cross(self: &Vector001Vec3, other: &Vector001Vec3) -> Vector001Vec3 {
            return Vector001Vec3 {
                x: self.y * other.z - self.z * other.y,
                y: self.z * other.x - self.x * other.z,
                z: self.x * other.y - self.y * other.x
            };
        }
    }

    func Simulate(seed: uint64) -> uint64 {
        var rng = Rng(seed);
        var sum = Vector001Vec3 { x: 0u64, y: 0u64, z: 0u64 };
        for i in 0u..22u {
            let x = rng.Next();
            let y = rng.Next();
            let z = rng.Next();
            let v = Vector001Vec3 { x: x, y: y, z: z };
            let scaled = v.Scale(0x46FC33FF15BEF56Bu64);
            let w = v.Cross(sum).Add(scaled);
            sum = sum.Add(w);
            if (sum.Dot(v) & 1u64) == 1u64 {
                sum = sum.Scale(0xDD4AAB4072C7E9u64);
            }
        }
        return sum.Dot(sum) ^ sum.x;
    }

    func KernelA(x: uint64, y: uint64) -> uint64 {
        var a: uint64 = x & (y << 6);
        var b: uint64 = y >> 47;
        for i in 0u64..6u64 {
            a = (a + i) * (i ^ b);
            b = b * Rotl(i << 49, 12u32);
            if ((a - 156u64) & 1023u64) != 523u64 {
                a = a | ((b | 0x3376D34B666D4591u64) % 728u64);
            } else {
                b = (b * a) + (b ^ 154u64);
            }
        }
        if ((b * x) & 1023u64) == 529u64 {
            a = a & ((b - 88u64) >> 26);
        } else {
            b = b | (a + x);
        }
        let c: uint64 = x + (b * 55u64);
        return c ^ (a + b);
    }

    func KernelB(x: uint64, y: uint64) -> uint64 {
        var a: uint64 = Rotl(x, 27u32);
        var b: uint64 = y & 255u64;
        for i in 0u64..6u64 {
            a = a - ((b + x) + (b & 118u64));
            b = Rotl(b, 18u32) - (b << 21);
            if ((i ^ b) & 65535u64) > 34281u64 {
                a = a - ((i >> 55) + 0xA01421F728036A41u64);
            } else {
                b = Rotl(b * 158u64, 12u32);
            }
        }
        let c: uint64 = Rotl(a, 16u32) << 8;
        let d: uint64 = (b << 1) & (a ^ 40u64);
        return (c ^ (a ^ b)) + d;
    }

    pub func Mix(x: uint64) -> uint64 {
        return KernelB(KernelA(x, 0x339596C5AC4F1FB1u64), x ^ 0x3A486CEBCEFA48B7u64);
    }

    pub func Run(seed: uint64) -> uint64 {
        let r = Simulate(seed ^ 0xD0F1527C73B2EFBDu64);
        return Mix(r);
    }
}
