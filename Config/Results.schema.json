{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark run",
  "type": "object",
  "properties": {
    "SchemaVersion": {
      "const": 1
    },
    "RunId": {
      "type": "string"
    },
    "StartedAt": {
      "type": "string"
    },
    "UpdatedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "Platform": {
      "enum": [
        "Windows",
        "Linux"
      ]
    },
    "Architecture": {
      "const": "x86-64"
    },
    "Profile": {
      "enum": [
        "Smoke",
        "Standard",
        "Large"
      ]
    },
    "Command": {
      "enum": [
        "prepare",
        "verify",
        "run"
      ]
    },
    "Status": {
      "enum": [
        "Running",
        "Completed",
        "Failed",
        "Interrupted"
      ]
    },
    "Settings": {
      "type": "object"
    },
    "Machine": {
      "type": "object",
      "required": [
        "Detected",
        "Manual",
        "Effective",
        "Warnings"
      ]
    },
    "Toolchains": {
      "type": "object"
    },
    "SourceHashes": {
      "type": "object"
    },
    "RuxPackageHashes": {
      "type": "object"
    },
    "Results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Benchmark": {
            "type": "string"
          },
          "Language": {
            "type": "string"
          },
          "Parameters": {
            "type": "object",
            "required": [
              "Size",
              "Work",
              "Seed"
            ]
          },
          "Status": {
            "enum": [
              "Building",
              "Measuring",
              "Prepared",
              "Verified",
              "Completed",
              "Failed",
              "Interrupted"
            ]
          },
          "Error": {
            "type": [
              "string",
              "null"
            ]
          },
          "BuildKind": {
            "enum": [
              "ManagedBuild",
              "NativeCompileAndLink"
            ]
          },
          "BuildCommand": {
            "type": [
              "object",
              "null"
            ]
          },
          "Dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ExecutableBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "DeployableBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "ManagedPayloadBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "RuntimeRequirement": {
            "type": "string"
          },
          "MemoryMetric": {
            "enum": [
              "WindowsPeakWorkingSet",
              "LinuxMaximumRSS"
            ]
          },
          "Validation": {
            "enum": [
              "IndependentReference",
              "ReferenceCasesAndCrossLanguage"
            ]
          },
          "BuildSeconds": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "ProcessSeconds": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "KernelSeconds": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "PeakMemoryBytes": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "Checksums": {
            "type": "array"
          },
          "Statistics": {
            "type": "object"
          }
        },
        "required": [
          "Benchmark",
          "Language",
          "Parameters",
          "Status",
          "Error",
          "BuildKind",
          "BuildCommand",
          "Dependencies",
          "ExecutableBytes",
          "DeployableBytes",
          "ManagedPayloadBytes",
          "RuntimeRequirement",
          "MemoryMetric",
          "Validation",
          "BuildSeconds",
          "ProcessSeconds",
          "KernelSeconds",
          "PeakMemoryBytes",
          "Checksums"
        ]
      }
    }
  },
  "required": [
    "SchemaVersion",
    "RunId",
    "StartedAt",
    "UpdatedAt",
    "Platform",
    "Architecture",
    "Profile",
    "Command",
    "Status",
    "Settings",
    "Machine",
    "Toolchains",
    "SourceHashes",
    "RuxPackageHashes",
    "Results"
  ]
}
