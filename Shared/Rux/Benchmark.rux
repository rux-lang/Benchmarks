import Core::Panic;
import Allocator::{ Allocator, SystemAllocator };
import Collections::Array;
import Io::{ StandardIn, StandardError, WriteAll, Print, PrintLine };
import Math::IsFinite;
import Time::Instant;

struct Parameters { size: int; work: int; seed: int; warmups: int; samples: int; }
struct Measurement { seconds: float64; sum: float64; weighted: float64; }

func Error(message: char8[..]) -> int {
    var error = StandardError::Acquire();
    WriteAll(error, message) catch { else => {} };
    return 1;
}

func ReadParameters() -> Parameters? {
    var input = StandardIn::Acquire();
    var buffer: char8[1];
    var values: int[6] = [0, 0, 0, 0, 0, 0];
    var field = 0;
    var active = false;
    var value = 0;
    while true {
        let count = input.Read(buffer[..]) catch {
            error => {
                if error.IsEnd() { break; }
                return none;
            }
        };
        if count == 0 { break; }
        let ch = buffer[0] as int;
        if ch >= 48 && ch <= 57 {
            active = true;
            value = value * 10 + ch - 48;
            if value > 2147483647 { return none; }
        } else {
            if ch != 32 && ch != 9 && ch != 10 && ch != 13 { return none; }
            if active {
                if field >= 6 { return none; }
                values[field] = value;
                field = field + 1;
                value = 0;
                active = false;
            }
        }
    }
    if active {
        if field >= 6 { return none; }
        values[field] = value;
        field = field + 1;
    }
    if field != 6 || values[0] != 1 || values[1] < 2 || values[1] > MaxSize ||
       values[2] < 1 || values[2] > 1000000 || values[3] > 1000000 ||
       values[4] > 100 || values[5] < 1 || values[5] > 1000 { return none; }
    if PowerOfTwo && (values[1] & (values[1] - 1)) != 0 { return none; }
    return Parameters { size: values[1], work: values[2], seed: values[3],
                        warmups: values[4], samples: values[5] };
}

func Main() -> int {
    let p = ReadParameters() ?? return Error("Invalid input parameters\n");
    var results: Measurement[1000];
    for i in 0..(p.warmups + p.samples) {
        let m = RunOnce(p);
        if !IsFinite(m.sum) || !IsFinite(m.weighted) || !IsFinite(m.seconds) || m.seconds < 0.0 {
            return Error("Nonfinite result or invalid clock\n");
        }
        if i >= p.warmups { results[i - p.warmups] = m; }
    }
    Print("{\"Protocol\":1,\"Benchmark\":\"");
    Print(BenchmarkName);
    Print("\",\"Size\":{},\"Work\":{},\"Seed\":{},\"Warmups\":{},\"Samples\":[",
          p.size, p.work, p.seed, p.warmups);
    for i in 0..p.samples {
        if i > 0 { Print(","); }
        let m = results[i];
        Print("{{\"Seconds\":{},\"Sum\":{},\"Weighted\":{}}}", m.seconds, m.sum, m.weighted);
    }
    PrintLine("]}");
    return 0;
}

