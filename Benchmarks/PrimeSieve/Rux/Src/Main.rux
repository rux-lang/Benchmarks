import Core::Panic;
import Allocator::{ Allocator, SystemAllocator };
import Collections::Array;
import Math::{ Cos, Sin, Sqrt };
import Time::Instant;

const BenchmarkName: char8[..] = "PrimeSieve";
const MaxSize: int = 200000000;
const PowerOfTwo: bool = false;

func RunOnce(p: Parameters) -> Measurement {
    var system = SystemAllocator();
    let allocator: Allocator = system;
    let n = p.size;
    var owner = Array::Filled<uint8>(allocator, (n + 1) as uint, 0u8) catch { else => Panic("Allocation failed") };
    let composite = owner.AsMutableSlice();
    let start = Instant::Now();
    var i = 2;
    while i <= n / i {
        if composite[i] == 0 {
            var j = i * i;
            while j <= n { composite[j] = 1; j += i; }
        }
        i += 1;
    }
    let seconds = (start.Elapsed().TotalNanoseconds() ?? 0) as float64 / 1000000000.0;
    var count: int64 = 0; var sum: int64 = 0;
    for k in 2..=n { if composite[k] == 0 { count += 1; sum += k as int64; } }
    return Measurement { seconds: seconds, sum: count as float64, weighted: sum as float64 };
}

