import Core::Panic;
import Allocator::{ Allocator, SystemAllocator };
import Collections::Array;
import Math::{ Cos, Sin, Sqrt };
import Time::Instant;

const BenchmarkName: char8[..] = "FastFourierTransform";
const MaxSize: int = 4194304;
const PowerOfTwo: bool = true;

func RunOnce(p: Parameters) -> Measurement {
    var system = SystemAllocator();
    let allocator: Allocator = system;
    let n = p.size;
    var rOwner = Array::Filled<float64>(allocator, n as uint, 0.0) catch { else => Panic("Allocation failed") };
    var iOwner = Array::Filled<float64>(allocator, n as uint, 0.0) catch { else => Panic("Allocation failed") };
    var wrOwner = Array::Filled<float64>(allocator, (n / 2) as uint, 0.0) catch { else => Panic("Allocation failed") };
    var wiOwner = Array::Filled<float64>(allocator, (n / 2) as uint, 0.0) catch { else => Panic("Allocation failed") };
    let real = rOwner.AsMutableSlice(); let imag = iOwner.AsMutableSlice();
    let wr = wrOwner.AsMutableSlice(); let wi = wiOwner.AsMutableSlice();
    for i in 0..n { real[i] = ((i + p.seed) % 17 - 8) as float64 / 8.0; }
    for i in 0..(n / 2) {
        let angle = -6.28318530717958647692 * i as float64 / n as float64;
        wr[i] = Cos(angle); wi[i] = Sin(angle);
    }
    let start = Instant::Now();
    var j = 0;
    for i in 1..n {
        var bit = n >> 1;
        while (j & bit) != 0 { j = j ^ bit; bit = bit >> 1; }
        j = j ^ bit;
        if i < j {
            let r = real[i]; real[i] = real[j]; real[j] = r;
            let v = imag[i]; imag[i] = imag[j]; imag[j] = v;
        }
    }
    var length = 2;
    while length <= n {
        let half = length / 2; let stride = n / length;
        var offset = 0;
        while offset < n {
            for k in 0..half {
                let left = offset + k; let right = left + half; let tw = k * stride;
                let tr = wr[tw] * real[right] - wi[tw] * imag[right];
                let ti = wr[tw] * imag[right] + wi[tw] * real[right];
                let lr = real[left]; let li = imag[left];
                real[left] = lr + tr; imag[left] = li + ti;
                real[right] = lr - tr; imag[right] = li - ti;
            }
            offset += length;
        }
        length *= 2;
    }
    let seconds = (start.Elapsed().TotalNanoseconds() ?? 0) as float64 / 1000000000.0;
    var sum = 0.0; var weighted = 0.0;
    for i in 0..n {
        sum += real[i] + imag[i];
        weighted += real[i] * (i % 7 + 1) as float64 + imag[i] * (i % 5 + 1) as float64;
    }
    return Measurement { seconds: seconds, sum: sum, weighted: weighted };
}

