import Core::Panic;
import Allocator::{ Allocator, SystemAllocator };
import Collections::Array;
import Math::{ Cos, Sin, Sqrt };
import Time::Instant;

const BenchmarkName: char8[..] = "MatrixMultiply";
const MaxSize: int = 2048;
const PowerOfTwo: bool = false;

func RunOnce(p: Parameters) -> Measurement {
    var system = SystemAllocator();
    let allocator: Allocator = system;
    let n = p.size;
    var aOwner = Array::Filled<float64>(allocator, (n * n) as uint, 0.0) catch { else => Panic("Allocation failed") };
    var bOwner = Array::Filled<float64>(allocator, (n * n) as uint, 0.0) catch { else => Panic("Allocation failed") };
    var cOwner = Array::Filled<float64>(allocator, (n * n) as uint, 0.0) catch { else => Panic("Allocation failed") };
    let a = aOwner.AsMutableSlice(); let b = bOwner.AsMutableSlice(); let c = cOwner.AsMutableSlice();
    for i in 0..n {
        for j in 0..n {
            a[i * n + j] = ((i + 3 * j + p.seed) % 17 - 8) as float64 / 8.0;
            b[i * n + j] = ((5 * i + j + p.seed) % 13 - 6) as float64 / 8.0;
        }
    }
    let start = Instant::Now();
    for i in 0..n {
        for k in 0..n {
            let value = a[i * n + k];
            for j in 0..n { c[i * n + j] += value * b[k * n + j]; }
        }
    }
    let seconds = (start.Elapsed().TotalNanoseconds() ?? 0) as float64 / 1000000000.0;
    var sum = 0.0; var weighted = 0.0;
    for i in 0..(n * n) { sum += c[i]; weighted += c[i] * (i % 7 + 1) as float64; }
    return Measurement { seconds: seconds, sum: sum, weighted: weighted };
}

