<Project>
  <!--
    NativeAOT links vcruntime statically but forces the Universal CRT to be a DLL
    (api-ms-win-crt-*). Link it statically too, so the executable needs only operating-system DLLs.
  -->
  <Target Name="LinkStaticUcrt" AfterTargets="SetupOSSpecificProps"
          Condition="'$(PublishAot)' == 'true' and $(RuntimeIdentifier.StartsWith('win'))">
    <ItemGroup>
      <LinkerArg Remove="/NODEFAULTLIB:libucrt.lib" />
      <LinkerArg Remove="/DEFAULTLIB:ucrt.lib" />
      <LinkerArg Include="/NODEFAULTLIB:ucrt.lib /DEFAULTLIB:libucrt.lib" />
    </ItemGroup>
  </Target>

  <!--
    The self-contained JIT runtime (coreclr, clrjit, the host) loads the Universal CRT as DLLs and
    cannot link it statically. Publish Microsoft's app-local copy from the Windows SDK next to it,
    as the JDK does with its own runtime, so the deployable size counts the C runtime it needs.
  -->
  <Target Name="PublishAppLocalUcrt" BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishAot)' != 'true' and '$(SelfContained)' == 'true' and $(RuntimeIdentifier.StartsWith('win'))">
    <PropertyGroup>
      <_KitsRoot>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots', 'KitsRoot10', null, RegistryView.Registry64, RegistryView.Registry32))</_KitsRoot>
    </PropertyGroup>
    <ItemGroup>
      <_UcrtBase Include="$(_KitsRoot)Redist\10.*\ucrt\DLLs\x64\ucrtbase.dll" />
    </ItemGroup>
    <!-- Batching assigns once per SDK version; the last (newest) one wins. -->
    <PropertyGroup>
      <_UcrtDir>%(_UcrtBase.RootDir)%(_UcrtBase.Directory)</_UcrtDir>
    </PropertyGroup>
    <Error Condition="'$(_UcrtDir)' == ''"
           Text="The app-local Universal CRT was not found under $(_KitsRoot)Redist\&lt;version&gt;\ucrt\DLLs\x64. Install the Windows SDK." />
    <ItemGroup>
      <_UcrtFile Include="$(_UcrtDir)*.dll" />
      <ResolvedFileToPublish Include="@(_UcrtFile)" RelativePath="%(_UcrtFile.Filename)%(_UcrtFile.Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    The Linux build of the self-contained JIT runtime (the apphost, hostfxr, hostpolicy, coreclr,
    clrjit) links libstdc++ dynamically. Publish the system's libstdc++.so.6 next to it, as on
    Windows with the Universal CRT, and give the apphost a RUNPATH of $ORIGIN so the loader takes
    that copy: the runtime libraries the apphost loads later then share it.
  -->
  <Target Name="PublishAppLocalLibstdcxx" BeforeTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishAot)' != 'true' and '$(SelfContained)' == 'true' and $(RuntimeIdentifier.StartsWith('linux'))">
    <PropertyGroup>
      <_Libstdcxx Condition="'$(_Libstdcxx)' == '' and Exists('/usr/lib/x86_64-linux-gnu/libstdc++.so.6')">/usr/lib/x86_64-linux-gnu/libstdc++.so.6</_Libstdcxx>
      <_Libstdcxx Condition="'$(_Libstdcxx)' == '' and Exists('/usr/lib64/libstdc++.so.6')">/usr/lib64/libstdc++.so.6</_Libstdcxx>
    </PropertyGroup>
    <Error Condition="'$(_Libstdcxx)' == ''"
           Text="libstdc++.so.6 was not found in /usr/lib/x86_64-linux-gnu or /usr/lib64." />
    <!-- Copy follows the symbolic link, so the published file is the library itself. -->
    <ItemGroup>
      <ResolvedFileToPublish Include="$(_Libstdcxx)" RelativePath="libstdc++.so.6" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="SetApphostRunpath" AfterTargets="Publish"
          Condition="'$(PublishAot)' != 'true' and '$(SelfContained)' == 'true' and $(RuntimeIdentifier.StartsWith('linux'))">
    <PropertyGroup>
      <PatchElf Condition="'$(PatchElf)' == ''">patchelf</PatchElf>
    </PropertyGroup>
    <Exec Command="&quot;$(PatchElf)&quot; --set-rpath '$ORIGIN' &quot;$(PublishDir)$(AssemblyName)&quot;" />
  </Target>

  <!--
    A trimmed self-contained publish still copies the runtime's optional native parts: debugger and
    dump support (mscordaccore, mscordbi, createdump, DiaSymReader), the standalone alternative GCs
    (clrgc, clrgcexp), QUIC (msquic) and, on Linux, the LTTng tracing provider (coreclrtraceptprovider,
    which needs liblttng-ust; the runtime starts without it when it is missing). The program runs
    without them, and jlink leaves the Java counterparts out, so the minimal deployment leaves them
    out too.
  -->
  <Target Name="RemoveOptionalRuntimeFiles" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishAot)' != 'true' and '$(SelfContained)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(lib)?(mscordaccore.*|mscordbi|createdump|Microsoft\.DiaSymReader\.Native\..*|clrgc|clrgcexp|msquic|coreclrtraceptprovider)$'))" />
    </ItemGroup>
  </Target>
</Project>
